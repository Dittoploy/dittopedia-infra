NODE_ENV=production

# Ports exposés sur la machine hôte
BACK_PORT=3000
FRONT_PORT=3001
DOCS_PORT=3002
POSTGRES_PORT=5432
VALKEY_PORT=6379
ADMINER_PORT=8080
SONARQUBE_PORT=9000

# URL du Backend (accessible depuis le navigateur)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Origine(s) frontend autorisée(s) côté backend (CORS), séparées par des virgules
FRONTEND_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=dittopedia
POSTGRES_PASSWORD=dittopedia
POSTGRES_DB=dittopedia

# SonarQube DB
SONARQUBE_DB_PASSWORD=sonarqube

# Deployment environment (Jenkins/Terraform/Bootstrap)
ENV_NAME=staging-aws-1
TF_ENV_NAME=staging-aws-1

# Terraform variables (auto-loaded by Terraform from TF_VAR_* env vars)
TF_VAR_environment=staging-aws-1
TF_VAR_master_instance_type=t3.micro
TF_VAR_worker_instance_type=t3.micro
TF_VAR_master_root_volume_size=20
TF_VAR_master_data_volume_size=20
TF_VAR_worker_root_volume_size=20

# Packer
PACKER_S3_BUCKET_NAME=dittopedia-packer-builds-01

# Ansible
ANSIBLE_VAULT_PASS=YOUR_ANSIBLE_VAULT_PASSWORD

# Github
DITTOPEDIA_INFRA_WEBHOOK=YOUR_GITHUB_WEBHOOK

# Add this in Jenkins Credentials
DOCKER_USERNAME=YOUR_DOCKER_USERNAME
DOCKER_PASSWORD=YOUR_DOCKER_PASSWORD

AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET

DITTOPEDIA_RDS_PASSWORD=YOUR_AWS_RDS_PASSWORD